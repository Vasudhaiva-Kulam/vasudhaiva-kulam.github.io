---
import BaseLayout from "../layouts/BaseLayout.astro";
import CampaignCard from "../components/CampaignCard.astro";
---

<BaseLayout title="Causes - Vasudhaiva Kulam">
  <main
    class="grow flex flex-col w-full max-w-container-max mx-auto px-margin-mobile md:px-gutter py-margin-desktop md:py-section-gap gap-12"
  >
    <!-- Page Header & Search -->
    <section class="flex flex-col gap-6 text-center max-w-3xl mx-auto w-full">
      <h1 class="font-display text-display-lg md:text-display-lg text-primary">
        Our Causes <br /><span
          class="text-on-surface-variant text-3xl md:text-4xl"
          >(कार्य और परियोजनाएं)</span
        >
      </h1>
      <p class="font-sans text-body-lg text-on-surface-variant">
        Join us in making a difference. Explore our ongoing projects across
        education, community welfare, and environmental sustainability.
      </p>
      <div class="relative w-full max-w-xl mx-auto mt-4">
        <span
          class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant"
          >search</span
        >
        <input
          class="w-full pl-12 pr-4 py-4 rounded-full border border-outline-variant bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-sans text-body-md text-on-surface placeholder-on-surface-variant transition-all shadow-sm"
          placeholder="Search projects (परियोजनाएं खोजें)..."
          type="text"
        />
      </div>
    </section>

    <!-- Filters/Tabs -->
    <section class="flex flex-wrap justify-center gap-4 w-full">
      <button
        class="px-6 py-2 rounded-full font-sans text-label-caps font-semibold uppercase tracking-wider border border-primary bg-primary-container text-on-primary shadow-sm hover:shadow-md transition-all"
        >All (सभी)</button
      >
      <button
        class="px-6 py-2 rounded-full font-sans text-label-caps font-semibold uppercase tracking-wider border border-outline-variant bg-surface-container-lowest text-on-surface-variant hover:border-primary hover:text-primary transition-all"
        >Education (शिक्षा)</button
      >
      <button
        class="px-6 py-2 rounded-full font-sans text-label-caps font-semibold uppercase tracking-wider border border-outline-variant bg-surface-container-lowest text-on-surface-variant hover:border-primary hover:text-primary transition-all"
        >Welfare (कल्याण)</button
      >
      <button
        class="px-6 py-2 rounded-full font-sans text-label-caps font-semibold uppercase tracking-wider border border-outline-variant bg-surface-container-lowest text-on-surface-variant hover:border-primary hover:text-primary transition-all"
        >Environment (पर्यावरण)</button
      >
    </section>

    <!-- Bento Grid of Campaign Cards -->
    <section
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full"
    >
      <!-- Card 1: Education -->
      <CampaignCard
        cardClass="glass-card"
        cardStyle=""
        imageSrc="https://lh3.googleusercontent.com/aida-public/AB6AXuAkG4xiI1DatZvEyj4WoTZoxEccVASXfadaolLxqdI4K2Sw55Opyg_FCzRbr55v75iYrlo04ox2HZE2mOwTGurtkPqb8mnRJASCMOWZpRpKEH-lkHzvVcF3fJW1J_hmA7GTIZGbUSUtgRwGjbgM2imIRS59lMYlDdZrXRUSIHaV7oszgOGfldrTKHxNfDJ7hqsG76Phx9-1o2D3XNOoUPOgoQKdkfmEvfpi_IpwFDBz_52gi2NiH08e"
        imageAlt="A brightly lit classroom in a rural Indian village. Children in neat uniforms are sitting at desks, looking attentively at a blackboard. The mood is hopeful and focused, with warm sunlight streaming through a window. The style is authentic documentary photography with vibrant natural colors, emphasizing the pristine white and saffron accents in the room."
        categoryIcon="school"
        categoryName="Education"
        badgeTextClass="text-tertiary"
        title="Sponsor a Child's Education"
        subtitle="(एक बच्चे की शिक्षा प्रायोजित करें)"
        description="Provide essential school supplies, tutoring, and support to underprivileged children, ensuring they have the tools to succeed."
        progressCurrent="₹50,000 Raised"
        progressGoal="Goal: ₹100,000"
        progressPercentage={50}
        buttonText="Donate Now"
      />

      <!-- Card 2: Environment -->
      <CampaignCard
        imageSrc="https://lh3.googleusercontent.com/aida-public/AB6AXuBcIeU_8s1Y5FZn9j7Wsc0l87m4R9pqkg7e33Unot9aX7H5ebQXtYV7nDr5hzrtudBM-4xxzW39-wv35n6e-snp1t-oOCkblZN15gzY33YSK0muOPuwxag2mCLwHX6RzaYvNPh7VMEsY_gUwKD_fiwl9Cnv2gEsjzATk4zTh6yWSeuz8NUwlSgWZdvtz_seQKjffdlqwMEQyFbj96HcAejpuCpnV5tKWl1wvJWKiI6ZTf94wofSu52F"
        imageAlt="A community tree planting drive in a suburban Indian area. Volunteers of various ages are kneeling in rich brown soil, planting green saplings. The lighting is bright and cheerful midday sun. The visual style is high-resolution, energetic, and optimistic, highlighting the deep green leaves and the pristine white shirts of some volunteers."
        categoryIcon="park"
        categoryName="Environment"
        badgeTextClass="text-secondary"
        title="Green Earth Plantation Drive"
        subtitle="(हरित पृथ्वी वृक्षारोपण अभियान)"
        description="Join our initiative to plant 10,000 trees this year. Help us restore local ecosystems and combat climate change through community action."
        progressCurrent="6,500 Trees"
        progressGoal="Goal: 10,000"
        progressPercentage={65}
        buttonText="Join Drive"
      />

      <!-- Card 3: Welfare -->
      <CampaignCard
        imageSrc="https://lh3.googleusercontent.com/aida-public/AB6AXuB1NgBNO9oxA7YNVJVx2JUHRG5cI6TpTubDLBJM9XS3LQ7SW6KT9ubSfNINXUXMB6RfJpKvYWkIcd_BfFaDlHdgJW9UQtD6GRJdXpy1xZRWPvmljPLO2ghFS28TyAODF_o8t6s90q6VtK1pnnA_9QzPXtutA7A_Iw2outeIyB1B4AW_jBaLF17e_KXKwsGDI6J1amZIxP01Mv-hiBH6wvRAcUymEXd051WnFpAdT6PQuoHV_R9HSlde"
        imageAlt="A clean, organized blood donation camp setting. Medical staff in crisp white coats are attending to donors resting on comfortable chairs. The environment feels safe, sterile, yet warm and welcoming with soft indoor lighting. The aesthetic uses clinical whites mixed with subtle saffron and navy accents from banners in the background."
        categoryIcon="bloodtype"
        categoryName="Welfare"
        badgeTextClass="text-error"
        title="Monthly Blood Donation Camp"
        subtitle="(मासिक रक्तदान शिविर)"
        description="Save lives by participating in our monthly community blood donation camps. Safe, hygienic, and crucial for local hospitals."
        progressCurrent="80 Donors"
        progressGoal="Goal: 150"
        progressPercentage={53}
        buttonText="Register"
      />
    </section>

    <!-- Impact Summary Section (Glassmorphism/Minimalist) -->
    <section
      class="w-full bg-surface-container-high rounded-xl p-8 md:p-12 mt-8 flex flex-col md:flex-row items-center justify-between gap-8 border border-outline-variant relative overflow-hidden"
    >
      <!-- Decorative element -->
      <div
        class="absolute top-0 right-0 w-64 h-64 bg-primary opacity-5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"
      >
      </div>
      <div
        class="flex flex-col gap-2 max-w-md relative z-10 text-center md:text-left"
      >
        <h2 class="font-display md:font-display text-on-surface">
          Can't find a specific project?
        </h2>
        <p class="font-sans text-on-surface-variant">
          Your general donation helps us allocate funds to the areas with the
          most urgent needs across all our causes.
        </p>
      </div>
      <a href="/donate">
        <button
          class="font-sans text-label-caps font-semibold uppercase tracking-wider py-4 px-8 rounded-full hover:shadow-lg hover:bg-primary transition-all whitespace-nowrap relative z-10 shadow-md transform hover:-translate-y-1 bg-primary-container text-on-primary"
        >
          Donate to General Fund (सामान्य कोष में दान करें)
        </button>
      </a>
    </section>
  </main>
</BaseLayout>
