---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pillar from "../components/Pillar.astro";
import classImage from "../assets/class.jpeg";
import bloodDonationImage from "../assets/blood-donation.jpeg";
import blanketImage from "../assets/blanket.jpeg";
---

<BaseLayout title="Home - Vasudhaiva Kulam">
  <main class="grow">
    <!-- Hero Section -->
    <section
      class="relative w-full min-h-[819px] flex items-center justify-center overflow-hidden"
    >
      <!-- Background Image -->
      <div
        class="absolute inset-0 z-0 bg-cover bg-center"
        data-alt="Our team"
        style="background-image: url('src/assets/us.jpeg')"
      >
        <!-- Gradient Overlay for readability -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-on-background/90 via-on-background/60 to-transparent"
        >
        </div>
      </div>
      <!-- Content Container -->
      <div
        class="relative z-10 max-w-container-max mx-auto px-gutter w-full flex flex-col gap-6 text-on-primary md:w-2/3 lg:w-1/2 justify-start items-start"
      >
        <div
          class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container/20 backdrop-blur-md rounded-full border border-on-primary/30"
        >
          <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"
          ></span>
          <span
            class="font-sans text-label-caps font-semibold uppercase tracking-wider text-on-primary"
            >वसुधैव कुलम्</span
          >
        </div>
        <h1
          class="font-display text-display-lg font-bold text-on-primary leading-tight"
        >
          Global Kinship.<br />
          <span class="text-primary-container">Local Impact.</span>
        </h1>
        <p
          class="font-sans text-body-lg text-inverse-on-surface max-w-xl opacity-90"
        >
          Empowering communities through education, welfare, and environmental
          stewardship. Join us in building a world where the entire earth is one
          family.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-4 w-full sm:w-auto">
          <button
            class="bg-primary-container hover:bg-primary-fixed text-on-primary-container px-8 py-4 rounded-full font-bold shadow-[0_4px_12px_rgba(255,153,51,0.3)] hover:shadow-[0_8px_24px_rgba(255,153,51,0.5)] transition-all flex items-center justify-center gap-2 transform hover:-translate-y-1"
          >
            Donate (दान करें)
            <span
              class="material-symbols-outlined"
              data-weight="fill"
              style="font-variation-settings: 'FILL' 1;">favorite</span
            >
          </button>
          <a href="/join">
            <button
              class="bg-surface/10 hover:bg-surface/20 backdrop-blur-sm border border-on-primary/50 text-on-primary px-8 py-4 rounded-full font-semibold transition-all flex items-center justify-center gap-2 transform hover:-translate-y-1"
            >
              Volunteer (स्वयंसेवक बनें)
              <span class="material-symbols-outlined">group_add</span>
            </button></a
          >
        </div>
      </div>
    </section>
    <!-- Stats Banner (Overlapping Hero) -->
    <section
      class="relative z-20 max-w-container-max mx-auto px-gutter -mt-16 md:-mt-12 mb-section-gap"
    >
      <div
        class="bg-surface rounded-xl shadow-[0_4px_24px_rgba(0,0,128,0.08)] p-6 md:p-8 flex flex-col md:flex-row justify-between items-center gap-8 border border-outline-variant/30 backdrop-blur-xl"
      >
        <div
          class="flex items-center gap-4 text-center md:text-left flex-1 justify-center md:justify-start"
        >
          <div
            class="p-3 bg-secondary-container/20 rounded-full text-secondary"
          >
            <span
              class="material-symbols-outlined text-3xl"
              data-weight="fill"
              style="font-variation-settings: 'FILL' 1;">school</span
            >
          </div>
          <div>
            <div
              class="font-display text-headline-md text-secondary counter"
              data-target="30"
            >
              0
            </div>
            <div
              class="font-sans text-body-md text-on-surface-variant font-semibold"
            >
              Students Mentored
            </div>
          </div>
        </div>
        <div class="hidden md:block w-px h-16 bg-outline-variant/50"></div>
        <div
          class="flex items-center gap-4 text-center md:text-left flex-1 justify-center md:justify-center"
        >
          <div
            class="p-3 bg-secondary-container/20 rounded-full text-secondary"
          >
            <span
              class="material-symbols-outlined text-3xl"
              data-weight="fill"
              style="font-variation-settings: 'FILL' 1;">park</span
            >
          </div>
          <div>
            <div
              class="font-display text-headline-md text-secondary counter"
              data-target="0"
            >
              0
            </div>
            <div
              class="font-sans text-body-md text-on-surface-variant font-semibold"
            >
              Trees Planted
            </div>
          </div>
        </div>
        <div class="hidden md:block w-px h-16 bg-outline-variant/50"></div>
        <div
          class="flex items-center gap-4 text-center md:text-left flex-1 justify-center md:justify-end"
        >
          <div class="p-3 bg-tertiary-container/20 rounded-full text-tertiary">
            <span
              class="material-symbols-outlined text-3xl"
              data-weight="fill"
              style="font-variation-settings: 'FILL' 1;">groups</span
            >
          </div>
          <div>
            <div
              class="font-display text-headline-md text-tertiary counter"
              data-target="7"
            >
              0
            </div>
            <div
              class="font-sans text-body-md text-on-surface-variant font-semibold"
            >
              Cities Reached
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Pillars Grid (3-column) -->
    <section
      class="py-section-gap px-gutter max-w-container-max mx-auto"
      id="causes"
    >
      <div class="text-center mb-16">
        <h2
          class="font-display md:font-display text-headline-md font-semibold text-on-surface mb-4"
        >
          Our Core Initiatives
        </h2>
        <p
          class="font-sans text-body-lg text-on-surface-variant max-w-2xl mx-auto"
        >
          Focused action areas designed to create lasting, sustainable impact in
          marginalized communities.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <Pillar
          title="Education"
          hindiTitle="शिक्षा"
          description="Providing quality education, resources, and mentorship to underprivileged youth to break the cycle of poverty."
          imageSrc={classImage.src}
          imageAlt="A volunteer teaching underprivileged kids"
          category="Education"
          icon="auto_stories"
          iconColor="text-tertiary"
        />

        <Pillar
          title="Health"
          hindiTitle="स्वास्थ्य"
          description="Ensuring access to basic healthcare by conducting periodic blood donation drives."
          imageSrc={bloodDonationImage.src}
          imageAlt="A volunteer donating blood"
          category="Health"
          icon="medical_services"
          iconColor="text-primary-container"
        />

        <Pillar
          title="Community Welfare"
          hindiTitle="जन कल्याण"
          description="Providing access to basic facilities by distributing blankets, food, lights, etc."
          imageSrc={blanketImage.src}
          imageAlt="Volunteer giving a blanket to an old man"
          category="Community Welfare"
          icon="groups"
          iconColor="text-secondary"
        />

        <Pillar
          title="Environment"
          hindiTitle="पर्यावरण"
          description="Promoting sustainable living, massive afforestation drives, and water conservation techniques."
          imageSrc="https://lh3.googleusercontent.com/aida-public/..."
          imageAlt="A wide shot of a tree plantation drive..."
          category="Environment"
          icon="eco"
          iconColor="text-tertiary"
        />
      </div>
    </section>
  </main>

  <script>
    // Counter Animation
    const counters = document.querySelectorAll(".counter");
    const speed = 200; // The HIGHER the number, the slower the animation

    // 1. Define the update function outside the loop
    const updateCount = (counter) => {
      const target = +counter.getAttribute("data-target");
      const count = +counter.innerText || 0; // Fallback to 0 if initially empty
      const inc = target / speed;

      if (count < target) {
        counter.innerText = Math.ceil(count + inc);
        requestAnimationFrame(() => updateCount(counter));
      } else {
        counter.innerText = target + "+"; // Add plus sign when done
      }
    };

    // 2. Create a SINGLE Intersection Observer for all counters
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateCount(entry.target);
          obs.unobserve(entry.target); // Run once per element
        }
      });
    });

    // 3. Loop through counters just to attach the observer
    counters.forEach((counter) => {
      observer.observe(counter);
    });
  </script>
</BaseLayout>
