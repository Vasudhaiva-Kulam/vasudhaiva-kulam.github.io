---
import FooterLink from "./FooterLink.astro";
import logo from "../assets/logo.png";
---

<footer
  class="bg-surface-container-highest dark:bg-surface-container-low text-on-surface-variant dark:text-on-surface font-sans text-body-md full-width border-t border-outline-variant mt-section-gap"
>
  <div
    class="flex flex-col md:flex-row justify-between items-start gap-8 py-section-gap px-gutter max-w-container-max mx-auto"
  >
    <div class="flex flex-col gap-4 max-w-xs">
      <div
        class="font-display text-title-sm font-semibold text-primary flex items-center gap-2"
      >
        <img src={logo.src} alt="Vasudhaiva Kulam" class="h-10" />
        Vasudhaiva Kulam
      </div>
      <p class="text-sm opacity-80">
        Global Kinship. Empowering communities through collective action and
        compassion.
      </p>
    </div>
    <div class="flex flex-col gap-3">
      <h4 class="font-semibold text-on-surface">Quick Links</h4>
      <FooterLink href="https://chat.whatsapp.com/Gw59zkm4bAg6KOFSVFMaLe"
        >WhatsApp Community</FooterLink
      >
      <FooterLink href="https://www.youtube.com/@Vasudhaivakulam"
        >YouTube Channel</FooterLink
      >
      <FooterLink href="https://www.instagram.com/vasudhaiva_kulam/"
        >Instagram</FooterLink
      >
      <FooterLink
        href="https://www.facebook.com/people/Vasudhaiva-kulam/61567640302886/"
        >Facebook</FooterLink
      >
      <FooterLink href="https://www.linkedin.com/company/145019977"
        >LinkedIn Page</FooterLink
      >
      <FooterLink href="/privacy">Privacy Policy</FooterLink>
      <FooterLink href="#">Terms of Service</FooterLink>
      <FooterLink href="#">Tax Benefits</FooterLink>
    </div>
    <div class="flex flex-col gap-4 max-w-sm">
      <h4 class="font-semibold text-on-surface">Registered Details</h4>
      <p class="text-sm opacity-80">
        © 2024 Vasudhaiva Kulam NGO. Registered 80G/12A. All donations are
        tax-exempt.
      </p>
    </div>
  </div>
</footer>
