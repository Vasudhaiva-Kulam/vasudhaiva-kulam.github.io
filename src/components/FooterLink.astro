---
interface Props {
  href: string;
}

const { href } = Astro.props;

// Optional: Automatically detect external links for security attributes
const isExternal = href.startsWith("http");
---

<a
  href={href}
  class="hover:text-primary transition-colors opacity-80 hover:opacity-100"
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <slot />
</a>
